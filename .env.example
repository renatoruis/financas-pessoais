# Usado pelo docker compose (raiz). Copiar para .env e preencher; o compose recusa arrancar
# sem POSTGRES_PASSWORD, AUTH_PASSWORD e AUTH_SECRET.
POSTGRES_USER=financas
# Senha forte: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=financas
DB_PORT=5432

# 127.0.0.1 = só nesta máquina; 0.0.0.0 = rede local do homeserver.
WEB_BIND=127.0.0.1
WEB_PORT=3000
APP_TIMEZONE=Europe/Lisbon

# Autenticação (só tu). AUTH_SECRET com pelo menos 32 caracteres: openssl rand -hex 32
AUTH_PASSWORD=
AUTH_SECRET=
