# Desenvolvimento local (pnpm dev) contra o Postgres do docker compose.
# Usar o mesmo POSTGRES_PASSWORD do .env da raiz.
DATABASE_URL=postgres://financas:<POSTGRES_PASSWORD>@127.0.0.1:5432/financas
APP_TIMEZONE=Europe/Lisbon

# Autenticação (só tu). AUTH_SECRET com pelo menos 32 caracteres: openssl rand -hex 32
AUTH_PASSWORD=
AUTH_SECRET=
